{
  "format_version": "1.21.80",
  "minecraft:entity": {
    "description": {
      "identifier": "golem:golem",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "golem:passive": {
        "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.6 }
      },
      "golem:follow": {
        "minecraft:behavior.follow_owner": { "priority": 5, "speed_multiplier": 1.0, "start_distance": 10, "stop_distance": 3 }
      },
      "golem:fighter": {
        "minecraft:attack": { "damage": 15 },
        "minecraft:behavior.melee_attack": { "priority": 2, "speed_multiplier": 1.0, "track_target": true },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "entity_types": [
            { "filters": { "test": "has_tag", "subject": "other", "value": "golem_target" }, "max_dist": 100 }
          ]
        },
        "minecraft:behavior.hurt_by_target": { "priority": 1 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["golem_commander", "mob"] },
      "minecraft:health": { "value": 100, "max": 100 },
      "minecraft:collision_box": { "width": 1.4, "height": 2.7 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:navigation.walk": { "can_path_over_water": false, "avoid_water": true, "can_pass_doors": true, "can_open_doors": false },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:tameable": { "probability": 0, "tame_items": "golem:never" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": { "priority": 8 },
      "minecraft:behavior.random_look_around": { "priority": 9 },
      "minecraft:persistent": {}
    },
    "events": {
      "golem:set_passive": { "sequence": [
        { "remove": { "component_groups": ["golem:follow", "golem:fighter"] } },
        { "add": { "component_groups": ["golem:passive"] } } ] },
      "golem:set_follow": { "sequence": [
        { "remove": { "component_groups": ["golem:passive", "golem:fighter"] } },
        { "add": { "component_groups": ["golem:follow"] } } ] },
      "golem:set_guard": { "sequence": [
        { "remove": { "component_groups": ["golem:passive"] } },
        { "add": { "component_groups": ["golem:follow", "golem:fighter"] } } ] },
      "golem:set_attack": { "sequence": [
        { "remove": { "component_groups": ["golem:passive", "golem:follow"] } },
        { "add": { "component_groups": ["golem:fighter"] } } ] },
      "golem:set_sentry": { "sequence": [
        { "remove": { "component_groups": ["golem:passive", "golem:follow"] } },
        { "add": { "component_groups": ["golem:fighter"] } } ] }
    }
  }
}
