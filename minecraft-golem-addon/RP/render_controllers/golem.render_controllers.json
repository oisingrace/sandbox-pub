{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.golem_commander": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.golem_statue": {
      "geometry": "query.variant == 1 ? Geometry.dead : Geometry.new",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.golem_statue_marks": {
      "geometry": "query.variant == 1 ? Geometry.marks_dead : Geometry.marks_new",
      "materials": [
        {
          "*": "Material.marks"
        }
      ],
      "textures": [
        "Texture.marks"
      ]
    }
  }
}